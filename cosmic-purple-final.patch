+.flow{display:flex;gap:7px;align-items:center;color:#6f6982;font-size:10px;margin-bottom:20px;padding:10px 14px;border:1px solid var(--line);border-radius:999px;background:rgba(18,16,39,.55);overflow:auto}.flow b{color:#bba4df;white-space:nowrap}.notice,.successNotice{border:1px solid rgba(243,174,85,.24);border-left:3px solid var(--warning);border-radius:10px;padding:12px 15px;background:rgba(87,57,21,.2);color:#ddc9a9;margin-bottom:18px}.successNotice{border-color:rgba(56,200,130,.2);border-left-color:var(--success);background:rgba(23,77,56,.2);color:#bde6d1}blockquote{margin:8px 0 14px;border-left:2px solid var(--primary);border-radius:0 9px 9px 0;padding:10px 13px;background:rgba(8,8,22,.65);color:#ebe5f5}.topicContext{display:flex;justify-content:space-between;gap:30px;margin-bottom:16px}.metricStrip{display:flex;gap:8px;align-items:center}.metricStrip span{border-left:1px solid var(--line);padding:10px 15px;font-size:9px;color:var(--muted)}.metricStrip b{display:block;font-size:22px;color:white}
+.candidateGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.candidate{position:relative;min-height:420px;display:flex;flex-direction:column}.candidate.recommended{border-color:rgba(212,86,204,.46);box-shadow:inset 0 3px #a862ff,0 20px 55px rgba(58,21,103,.3)}.recommend,.option{font-size:9px;letter-spacing:.12em;color:#bf91ff}.recommend{align-self:flex-start;padding:5px 9px;border-radius:999px;background:linear-gradient(90deg,rgba(137,71,232,.28),rgba(224,65,164,.24));border:1px solid rgba(220,100,224,.25)}.candidateScore{position:absolute;right:18px;top:18px;text-align:right}.candidateScore b{display:block;font-size:30px}.candidateScore small{font-size:9px;color:var(--muted)}.candidate .actions{margin-top:auto}.candidate details{margin:12px 0;color:var(--muted)}.candidate summary,.manualMode summary{cursor:pointer;font-size:11px;color:#c9bdd9}.lowConfidence{background:rgba(113,71,19,.28);color:#f4bd68;padding:7px;border-radius:6px;margin-bottom:12px;font-size:9px;font-weight:700}.emptyGeneration{text-align:center;padding:45px;margin-bottom:14px}.manualMode{margin-top:18px}.manualMode form{margin-top:18px}.claims{margin:20px 0;border-top:1px solid var(--line);padding-top:16px}.priorityVariant{border-top:2px solid var(--primary);box-shadow:inset 0 3px 18px rgba(140,82,235,.07),var(--shadow)}
+.uploadBox{margin-top:16px;border:1px dashed rgba(164,124,229,.34);border-radius:11px;padding:14px;display:flex;justify-content:space-between;gap:12px;align-items:flex-end;background:rgba(9,8,23,.35)}.videoAsset{margin-top:16px}.videoAsset video,.panel>video{width:100%;max-height:560px;border-radius:12px;background:#04040a;box-shadow:0 15px 40px #030208}.integrationGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:18px}.integrationCard{display:flex;gap:18px;min-height:210px}.channelMark{width:48px;height:48px;flex:none;border:1px solid var(--line-strong);border-radius:13px;background:linear-gradient(145deg,#30205d,#17162f);display:grid;place-items:center;font-weight:800;color:#c49bff}.statusPill{display:inline-block;font-size:9px;padding:4px 8px;border-radius:999px;background:#29253a;color:#aaa3b8}.statusPill.connected{background:rgba(29,112,75,.28);color:#77dfa9}.mutedCard{opacity:.64}.configMissing{font-size:11px;color:#d8b978}.distribution{grid-column:1/-1}.bulkDistribution,.channelRow{background:rgba(8,8,22,.55);border:1px solid var(--line);border-radius:10px;padding:14px}.bulkDistribution{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.bulkDistribution label{display:flex;grid-template-columns:auto 1fr;align-items:center;gap:7px}.bulkDistribution input{width:auto}.distributionGrid{display:grid;gap:7px}.channelRow{display:flex;align-items:center;justify-content:space-between}hr{border:0!important;border-top:1px solid var(--line)!important}
+@media(max-width:1100px){.candidateGrid,.integrationGrid{grid-template-columns:1fr}.topicContext{display:block}.metricStrip{margin-top:15px}.page{padding-inline:26px}}
+@media(max-width:900px){aside{position:relative;width:100%;height:auto}aside nav{grid-template-columns:repeat(2,1fr)}.sideFoot{margin-top:16px}main{margin-left:0}header{position:relative}.span3,.span4,.span5,.span6,.span7,.span8{grid-column:1/-1}.page{padding:22px}.formGrid{grid-template-columns:1fr}.metricStrip{display:grid;grid-template-columns:repeat(3,1fr)}.titleRow{align-items:flex-start;gap:14px}.panel{overflow-x:auto}}
+@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
